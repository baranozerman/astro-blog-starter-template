---
import Portal from "../../layouts/Portal.astro";
import Icon from "../../components/portal/Icon.astro";
import { listAccessibleFolders, formatRelative } from "../../lib/portal";

export const prerender = false;

const user = Astro.locals.user!;
const { lang, t } = Astro.locals;
const folders = await listAccessibleFolders(Astro.locals.runtime.env.DB, user);
const firstName = user.name.split(/\s+/)[0];
---

<Portal title={t("home.title")}>
	<div class="page-head">
		<div>
			<h1>{t("home.hello", { name: firstName })}</h1>
			<p class="muted">
				{folders.length > 0 ? t("home.count", { n: folders.length }) : t("home.count_none")}
			</p>
		</div>
		{
			user.role === "admin" && (
				<a class="btn" href="/portal/admin#yeni-klasor">
					<Icon name="plus" /> {t("home.new_folder")}
				</a>
			)
		}
	</div>

	{
		folders.length === 0 ? (
			<div class="panel empty">
				<Icon name="folder" size={40} />
				<strong>{t("home.empty_title")}</strong>
				<span>{t("home.empty_body")}</span>
			</div>
		) : (
			<div class="cards">
				{folders.map((f) => (
					<a class="card" href={`/portal/folders/${f.id}`}>
						<div class="card-top">
							<span class="folder-icon">
								<Icon name="folder" size={22} />
							</span>
							<div>
								<h3>{f.name}</h3>
								{f.description && <p>{f.description}</p>}
							</div>
						</div>
						<div class="badges">
							{f.can_read ? (
								<span class="badge">
									<Icon name="eye" size={13} /> {t("home.badge_view")}
								</span>
							) : null}
							{f.can_upload ? (
								<span class="badge green">
									<Icon name="upload" size={13} /> {t("home.badge_upload")}
								</span>
							) : null}
						</div>
						<div class="card-foot">
							<span>
								{f.can_read ? t("common.files_n", { n: f.file_count }) : t("home.upload_only")}
								{f.folder_count > 0 && ` · ${t("common.folders_n", { n: f.folder_count })}`}
							</span>
							<span>{f.can_read && f.last_upload ? formatRelative(f.last_upload, lang, t) : ""}</span>
						</div>
					</a>
				))}
			</div>
		)
	}
</Portal>
