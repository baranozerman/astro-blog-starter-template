---
import Portal from "../../layouts/Portal.astro";
import { attemptLogin, createSession } from "../../lib/auth";
import { audit, safeNext } from "../../lib/portal";

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const { t } = Astro.locals;
const next = safeNext(Astro.url.searchParams.get("next"));
if (Astro.locals.user) return Astro.redirect(next);

const userCount = await DB.prepare("SELECT COUNT(*) AS n FROM users").first<number>("n");
if (userCount === 0) return Astro.redirect("/portal/setup");

let error = "";
let email = "";
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	email = String(form.get("email") ?? "").trim().toLowerCase();
	const password = String(form.get("password") ?? "");
	const result = await attemptLogin(DB, email, password);
	if ("userId" in result) {
		await createSession(DB, Astro.cookies, Astro.url, result.userId);
		await audit(DB, result.userId, "login").run();
		return Astro.redirect(next);
	}
	error = result.error === "locked" ? t("err.locked") : t("err.bad_login");
}
---

<Portal title={t("login.title")} bare error={error}>
	<h2>{t("login.heading")}</h2>
	<p class="lead">{t("login.lead")}</p>
	<form method="post" class="stack">
		<label>
			{t("common.email")}
			<input type="email" name="email" value={email} required autocomplete="username" autofocus />
		</label>
		<label>
			{t("common.password")}
			<input type="password" name="password" required autocomplete="current-password" />
		</label>
		<button type="submit" class="btn block">{t("login.submit")}</button>
	</form>
	<p class="hint">{t("login.help")}</p>
</Portal>
