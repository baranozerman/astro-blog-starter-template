---
import Portal from "../../../../layouts/Portal.astro";
import { audit, parseId, type Folder } from "../../../../lib/portal";
import { StorageError, deleteStored } from "../../../../lib/storage";

export const prerender = false;

const env = Astro.locals.runtime.env;
const { DB } = env;
const admin = Astro.locals.user!;
const folderId = parseId(Astro.params.id);
const folder = folderId
	? await DB.prepare("SELECT id, name, description FROM folders WHERE id = ?").bind(folderId).first<Folder>()
	: null;
if (!folder) return Astro.redirect("/portal/admin");
const here = `/portal/admin/folders/${folder.id}`;

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = form.get("action");

	if (action === "update") {
		const name = String(form.get("name") ?? "").trim();
		const description = String(form.get("description") ?? "").trim();
		if (!name) return Astro.redirect(`${here}?err=invalid`);
		await DB.batch([
			DB.prepare("UPDATE folders SET name = ?, description = ? WHERE id = ?").bind(name, description, folder.id),
			audit(DB, admin.id, "folder_update", name),
		]);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "permissions") {
		const read = new Set(form.getAll("read").map(String));
		const upload = new Set(form.getAll("upload").map(String));
		const userIds = [...new Set([...read, ...upload])].map(parseId).filter((n) => n !== null);
		await DB.batch([
			DB.prepare("DELETE FROM permissions WHERE folder_id = ?").bind(folder.id),
			...userIds.map((uid) =>
				DB.prepare(
					`INSERT INTO permissions (user_id, folder_id, can_read, can_upload)
					 SELECT id, ?, ?, ? FROM users WHERE id = ?`,
				).bind(folder.id, read.has(String(uid)) ? 1 : 0, upload.has(String(uid)) ? 1 : 0, uid),
			),
			audit(DB, admin.id, "permissions", folder.name),
		]);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "delete") {
		const { results } = await DB.prepare("SELECT r2_key FROM files WHERE folder_id = ?")
			.bind(folder.id)
			.all<{ r2_key: string }>();
		try {
			await deleteStored(env, results.map((r) => r.r2_key));
		} catch (e) {
			if (e instanceof StorageError) {
				console.error(e.message);
				return Astro.redirect(`${here}?err=storage`);
			}
			throw e;
		}
		await DB.batch([
			DB.prepare("DELETE FROM folders WHERE id = ?").bind(folder.id),
			audit(DB, admin.id, "folder_delete", folder.name),
		]);
		return Astro.redirect("/portal/admin?ok=deleted");
	}
}

const { results: customers } = await DB.prepare(
	`SELECT u.id, u.name, u.company, u.email, u.active,
	        COALESCE(p.can_read, 0) AS can_read, COALESCE(p.can_upload, 0) AS can_upload
	 FROM users u LEFT JOIN permissions p ON p.user_id = u.id AND p.folder_id = ?
	 WHERE u.role = 'customer'
	 ORDER BY u.company COLLATE NOCASE, u.name COLLATE NOCASE`,
)
	.bind(folder.id)
	.all<{ id: number; name: string; company: string; email: string; active: number; can_read: number; can_upload: number }>();
const fileCount = await DB.prepare("SELECT COUNT(*) AS n FROM files WHERE folder_id = ?")
	.bind(folder.id)
	.first<number>("n");
---

<Portal title={`${folder.name} – Ayarlar`}>
	<div class="page-head">
		<div>
			<div class="breadcrumb"><a href="/portal/admin">Yönetim</a> / Klasörler /</div>
			<h1>{folder.name}</h1>
			<p class="muted">{fileCount} dosya</p>
		</div>
		<a class="btn secondary" href={`/portal/folders/${folder.id}`}>Dosyaları aç</a>
	</div>

	<div class="panel">
		<h2>Bilgiler</h2>
		<form method="post" class="stack">
			<input type="hidden" name="action" value="update" />
			<label>Klasör adı <input type="text" name="name" value={folder.name} required /></label>
			<label>Açıklama <textarea name="description" rows="3">{folder.description}</textarea></label>
			<div><button type="submit" class="btn">Kaydet</button></div>
		</form>
	</div>

	<div class="panel">
		<h2>Müşteri erişimi</h2>
		{
			customers.length === 0 ? (
				<p class="muted">
					Henüz müşteri hesabı yok. <a href="/portal/admin">Yönetim sayfasından</a> oluşturabilirsiniz.
				</p>
			) : (
				<form method="post">
					<input type="hidden" name="action" value="permissions" />
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th>Kullanıcı</th>
									<th>Şirket</th>
									<th class="center">Görüntüle / indir</th>
									<th class="center">Yükle</th>
								</tr>
							</thead>
							<tbody>
								{customers.map((u) => (
									<tr>
										<td>
											<a href={`/portal/admin/users/${u.id}`}>{u.name}</a>{" "}
											<span class="muted">{u.email}</span>{" "}
											{!u.active && <span class="badge red">Pasif</span>}
										</td>
										<td>{u.company}</td>
										<td class="center">
											<input type="checkbox" name="read" value={u.id} checked={u.can_read === 1} aria-label={`${u.name} görüntüle`} />
										</td>
										<td class="center">
											<input type="checkbox" name="upload" value={u.id} checked={u.can_upload === 1} aria-label={`${u.name} yükle`} />
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="hint">Yöneticiler tüm klasörlere otomatik olarak erişir.</p>
					<button type="submit" class="btn">İzinleri kaydet</button>
				</form>
			)
		}
	</div>

	<div class="panel danger-zone">
		<h2>Klasörü sil</h2>
		<form method="post" onsubmit="return confirm('Klasör ve içindeki TÜM dosyalar kalıcı olarak silinsin mi?')">
			<input type="hidden" name="action" value="delete" />
			<p class="hint">Klasördeki {fileCount} dosya da kalıcı olarak silinir.</p>
			<button type="submit" class="btn danger">Klasörü sil</button>
		</form>
	</div>
</Portal>
