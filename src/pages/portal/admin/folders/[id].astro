---
import Portal from "../../../../layouts/Portal.astro";
import Icon from "../../../../components/portal/Icon.astro";
import AdminTabs from "../../../../components/portal/AdminTabs.astro";
import AccessSelect from "../../../../components/portal/AccessSelect.astro";
import { audit, formatBytes, parseId, subtreeIds, type Folder } from "../../../../lib/portal";
import { StorageError, deleteStored } from "../../../../lib/storage";
import { listUsers, permissionMap, readAccessForm, saveAccess } from "../../../../lib/admin";
import { rawMessage } from "../../../../lib/i18n";

export const prerender = false;

const env = Astro.locals.runtime.env;
const { DB } = env;
const admin = Astro.locals.user!;
const { lang, t } = Astro.locals;
const folderId = parseId(Astro.params.id);
const folder = folderId ? await DB.prepare("SELECT * FROM folders WHERE id = ?").bind(folderId).first<Folder>() : null;
if (!folder) return Astro.redirect("/portal/admin/folders");
// Access is managed on top-level folders; subfolders are handled in the file manager.
if (folder.parent_id !== null) return Astro.redirect(`/portal/folders/${folder.id}`);
const treeIds = await subtreeIds(DB, folder.id);
const inTree = treeIds.map(() => "?").join(",");
const here = `/portal/admin/folders/${folder.id}`;

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = form.get("action");

	if (action === "update") {
		const name = String(form.get("name") ?? "").trim();
		const description = String(form.get("description") ?? "").trim();
		if (!name) return Astro.redirect(`${here}?err=invalid`);
		await DB.batch([
			DB.prepare("UPDATE folders SET name = ?, description = ? WHERE id = ?").bind(name, description, folder.id),
			audit(DB, admin.id, "folder_update", name),
		]);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "access") {
		const changes = (await readAccessForm(DB, form)).filter((c) => c.folderId === folder.id);
		await saveAccess(DB, admin.id, changes);
		return Astro.redirect(`${here}?ok=access`);
	}

	if (action === "delete") {
		const { results } = await DB.prepare(`SELECT r2_key FROM files WHERE folder_id IN (${inTree})`)
			.bind(...treeIds)
			.all<{ r2_key: string }>();
		try {
			await deleteStored(env, results.map((r) => r.r2_key));
		} catch (e) {
			if (e instanceof StorageError) {
				console.error(e.message);
				return Astro.redirect(`${here}?err=storage`);
			}
			throw e;
		}
		await DB.batch([
			DB.prepare(`DELETE FROM files WHERE folder_id IN (${inTree})`).bind(...treeIds),
			// Subfolders go with it (ON DELETE CASCADE on parent_id).
			DB.prepare("DELETE FROM folders WHERE id = ?").bind(folder.id),
			audit(DB, admin.id, "folder_delete", folder.name),
		]);
		return Astro.redirect("/portal/admin/folders?ok=deleted");
	}
}

const [users, perms, totals] = await Promise.all([
	listUsers(DB),
	permissionMap(DB),
	DB.prepare(`SELECT COUNT(*) AS files, COALESCE(SUM(size), 0) AS bytes FROM files WHERE folder_id IN (${inTree})`)
		.bind(...treeIds)
		.first<{ files: number; bytes: number }>(),
]);
const customers = users.filter((u) => u.role === "customer");
const level = (userId: number) => perms.get(`${userId}:${folder.id}`) ?? "none";
const withAccess = customers.filter((u) => level(u.id) !== "none").length;
---

<Portal title={t("admin.folder_settings", { name: folder.name })}>
	<div class="page-head">
		<div>
			<nav class="breadcrumb">
				<a href="/portal/admin/folders"><Icon name="folder" size={14} /> {t("admin.tab_folders")}</a>
				<Icon name="chevron" size={14} />
			</nav>
			<h1>{folder.name}</h1>
			{folder.description && <p class="lead-light">{folder.description}</p>}
		</div>
		<div class="head-actions">
			<a class="btn glass" href={`/portal/folders/${folder.id}`}><Icon name="folder" /> {t("admin.open_files")}</a>
		</div>
	</div>

	<AdminTabs />

	<div class="stats">
		<div class="stat">
			<span class="stat-icon"><Icon name="file" size={20} /></span>
			<div><strong>{totals?.files ?? 0}</strong><span>{t("admin.stat_files")}</span></div>
		</div>
		<div class="stat">
			<span class="stat-icon"><Icon name="folder" size={20} /></span>
			<div><strong>{treeIds.length - 1}</strong><span>{t("admin.subfolders")}</span></div>
		</div>
		<div class="stat">
			<span class="stat-icon"><Icon name="database" size={20} /></span>
			<div><strong>{formatBytes(totals?.bytes ?? 0, lang)}</strong><span>{t("admin.size")}</span></div>
		</div>
		<div class="stat">
			<span class="stat-icon"><Icon name="users" size={20} /></span>
			<div><strong>{withAccess}</strong><span>{t("admin.stat_customers")}</span></div>
		</div>
	</div>

	<div class="grid-2">
		<div class="panel">
			<div class="panel-head">
				<h2>{t("admin.customer_access")}</h2>
				{customers.length > 0 && <a class="btn small secondary" href="/portal/admin/access"><Icon name="shield" size={14} /> {t("admin.access_title")}</a>}
			</div>
			{
				customers.length === 0 ? (
					<p class="muted">
						<a href="/portal/admin/users#new">{t("admin.no_customers")}</a>
					</p>
				) : (
					<form method="post" data-access-form>
						<input type="hidden" name="action" value="access" />
						<p class="hint">{t("admin.folder_users_lead")}</p>
						<div class="access-list">
							{customers.map((u) => (
								<div class="access-item">
									<a class="access-name" href={`/portal/admin/users/${u.id}`}>
										<strong>{u.name}</strong>
										<span class="muted small">{u.company || u.email}</span>
									</a>
									{!u.active && <span class="badge red">{t("common.inactive")}</span>}
									<AccessSelect name={`access:${u.id}:${folder.id}`} value={level(u.id)} label={u.name} />
								</div>
							))}
						</div>
						<p class="hint">{t("admin.admins_auto")}</p>
						<div class="save-bar" data-save-bar data-template={rawMessage(lang, "admin.access_changed")}>
							<span data-count></span>
							<button type="button" class="btn secondary small" data-reset>{t("admin.access_reset")}</button>
							<button type="submit" class="btn">{t("admin.save_permissions")}</button>
						</div>
					</form>
				)
			}
		</div>

		<div>
			<div class="panel">
				<h2>{t("admin.details")}</h2>
				<form method="post" class="stack">
					<input type="hidden" name="action" value="update" />
					<label>{t("common.folder_name")} <input type="text" name="name" value={folder.name} required /></label>
					<label>{t("common.description")} <textarea name="description" rows="3">{folder.description}</textarea></label>
					<div><button type="submit" class="btn">{t("common.save")}</button></div>
				</form>
			</div>

			<div class="panel danger-zone">
				<h2>{t("admin.danger")}</h2>
				<form method="post" data-confirm={t("admin.delete_folder_confirm")} class="danger-row">
					<input type="hidden" name="action" value="delete" />
					<p class="hint">{t("admin.delete_folder_hint", { n: totals?.files ?? 0 })}</p>
					<button type="submit" class="btn danger"><Icon name="trash" size={16} /> {t("admin.delete_folder")}</button>
				</form>
			</div>
		</div>
	</div>
</Portal>
