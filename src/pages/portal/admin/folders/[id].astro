---
import Portal from "../../../../layouts/Portal.astro";
import { audit, parseId, subtreeIds, type Folder } from "../../../../lib/portal";
import { StorageError, deleteStored } from "../../../../lib/storage";

export const prerender = false;

const env = Astro.locals.runtime.env;
const { DB } = env;
const admin = Astro.locals.user!;
const { t } = Astro.locals;
const folderId = parseId(Astro.params.id);
const folder = folderId
	? await DB.prepare("SELECT * FROM folders WHERE id = ?").bind(folderId).first<Folder>()
	: null;
if (!folder) return Astro.redirect("/portal/admin");
// Access is managed on top-level folders; subfolders are handled in the file manager.
if (folder.parent_id !== null) return Astro.redirect(`/portal/folders/${folder.id}`);
const treeIds = await subtreeIds(DB, folder.id);
const inTree = treeIds.map(() => "?").join(",");
const here = `/portal/admin/folders/${folder.id}`;

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = form.get("action");

	if (action === "update") {
		const name = String(form.get("name") ?? "").trim();
		const description = String(form.get("description") ?? "").trim();
		if (!name) return Astro.redirect(`${here}?err=invalid`);
		await DB.batch([
			DB.prepare("UPDATE folders SET name = ?, description = ? WHERE id = ?").bind(name, description, folder.id),
			audit(DB, admin.id, "folder_update", name),
		]);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "permissions") {
		const read = new Set(form.getAll("read").map(String));
		const upload = new Set(form.getAll("upload").map(String));
		const userIds = [...new Set([...read, ...upload])].map(parseId).filter((n) => n !== null);
		await DB.batch([
			DB.prepare("DELETE FROM permissions WHERE folder_id = ?").bind(folder.id),
			...userIds.map((uid) =>
				DB.prepare(
					`INSERT INTO permissions (user_id, folder_id, can_read, can_upload)
					 SELECT id, ?, ?, ? FROM users WHERE id = ?`,
				).bind(folder.id, read.has(String(uid)) ? 1 : 0, upload.has(String(uid)) ? 1 : 0, uid),
			),
			audit(DB, admin.id, "permissions", folder.name),
		]);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "delete") {
		const { results } = await DB.prepare(`SELECT r2_key FROM files WHERE folder_id IN (${inTree})`)
			.bind(...treeIds)
			.all<{ r2_key: string }>();
		try {
			await deleteStored(env, results.map((r) => r.r2_key));
		} catch (e) {
			if (e instanceof StorageError) {
				console.error(e.message);
				return Astro.redirect(`${here}?err=storage`);
			}
			throw e;
		}
		await DB.batch([
			DB.prepare(`DELETE FROM files WHERE folder_id IN (${inTree})`).bind(...treeIds),
			// Subfolders go with it (ON DELETE CASCADE on parent_id).
			DB.prepare("DELETE FROM folders WHERE id = ?").bind(folder.id),
			audit(DB, admin.id, "folder_delete", folder.name),
		]);
		return Astro.redirect("/portal/admin?ok=deleted");
	}
}

const { results: customers } = await DB.prepare(
	`SELECT u.id, u.name, u.company, u.email, u.active,
	        COALESCE(p.can_read, 0) AS can_read, COALESCE(p.can_upload, 0) AS can_upload
	 FROM users u LEFT JOIN permissions p ON p.user_id = u.id AND p.folder_id = ?
	 WHERE u.role = 'customer'
	 ORDER BY u.company COLLATE NOCASE, u.name COLLATE NOCASE`,
)
	.bind(folder.id)
	.all<{ id: number; name: string; company: string; email: string; active: number; can_read: number; can_upload: number }>();
const fileCount = await DB.prepare(`SELECT COUNT(*) AS n FROM files WHERE folder_id IN (${inTree})`)
	.bind(...treeIds)
	.first<number>("n");
---

<Portal title={t("admin.folder_settings", { name: folder.name })}>
	<div class="page-head">
		<div>
			<div class="breadcrumb"><a href="/portal/admin">{t("admin.title")}</a> / {t("admin.folders")} /</div>
			<h1>{folder.name}</h1>
			<p class="lead-light">{t("common.files_n", { n: fileCount ?? 0 })}{treeIds.length > 1 && ` · ${t("common.subfolders_n", { n: treeIds.length - 1 })}`}</p>
		</div>
		<a class="btn secondary" href={`/portal/folders/${folder.id}`}>{t("admin.open_files")}</a>
	</div>

	<div class="panel">
		<h2>{t("admin.details")}</h2>
		<form method="post" class="stack">
			<input type="hidden" name="action" value="update" />
			<label>{t("common.folder_name")} <input type="text" name="name" value={folder.name} required /></label>
			<label>{t("common.description")} <textarea name="description" rows="3">{folder.description}</textarea></label>
			<div><button type="submit" class="btn">{t("common.save")}</button></div>
		</form>
	</div>

	<div class="panel">
		<h2>{t("admin.customer_access")}</h2>
		{
			customers.length === 0 ? (
				<p class="muted">
					<a href="/portal/admin">{t("admin.no_customers")}</a>
				</p>
			) : (
				<form method="post">
					<input type="hidden" name="action" value="permissions" />
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th>{t("admin.col_user")}</th>
									<th>{t("common.company")}</th>
									<th class="center">{t("common.view_download")}</th>
									<th class="center">{t("common.upload")}</th>
								</tr>
							</thead>
							<tbody>
								{customers.map((u) => (
									<tr>
										<td>
											<a href={`/portal/admin/users/${u.id}`}>{u.name}</a>{" "}
											<span class="muted">{u.email}</span>{" "}
											{!u.active && <span class="badge red">{t("common.inactive")}</span>}
										</td>
										<td>{u.company}</td>
										<td class="center">
											<input type="checkbox" name="read" value={u.id} checked={u.can_read === 1} aria-label={`${u.name}: ${t("common.view_download")}`} />
										</td>
										<td class="center">
											<input type="checkbox" name="upload" value={u.id} checked={u.can_upload === 1} aria-label={`${u.name}: ${t("common.upload")}`} />
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="hint">{t("admin.admins_auto")}</p>
					<button type="submit" class="btn">{t("admin.save_permissions")}</button>
				</form>
			)
		}
	</div>

	<div class="panel danger-zone">
		<h2>{t("admin.delete_folder")}</h2>
		<form method="post" data-confirm={t("admin.delete_folder_confirm")}>
			<input type="hidden" name="action" value="delete" />
			<p class="hint">{t("admin.delete_folder_hint", { n: fileCount ?? 0 })}</p>
			<button type="submit" class="btn danger">{t("admin.delete_folder")}</button>
		</form>
	</div>
</Portal>
