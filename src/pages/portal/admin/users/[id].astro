---
import Portal from "../../../../layouts/Portal.astro";
import Icon from "../../../../components/portal/Icon.astro";
import AdminTabs from "../../../../components/portal/AdminTabs.astro";
import AccessSelect from "../../../../components/portal/AccessSelect.astro";
import { clearTotp, destroyUserSessions, hashPassword, passwordProblem } from "../../../../lib/auth";
import { audit, formatDate, formatRelative, parseId } from "../../../../lib/portal";
import { listRoots, permissionMap, randomPassword, readAccessForm, saveAccess, type UserRow } from "../../../../lib/admin";
import { rawMessage } from "../../../../lib/i18n";

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const admin = Astro.locals.user!;
const { lang, t } = Astro.locals;
const userId = parseId(Astro.params.id);
const user = userId
	? await DB.prepare(
			`SELECT u.*, (SELECT MAX(created_at) FROM audit_log a WHERE a.user_id = u.id AND a.action = 'login') AS last_login
			 FROM users u WHERE u.id = ?`,
		)
			.bind(userId)
			.first<UserRow>()
	: null;
if (!user) return Astro.redirect("/portal/admin/users");
const here = `/portal/admin/users/${user.id}`;
const isSelf = user.id === admin.id;

let error = "";
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = form.get("action");

	if (action === "update") {
		const name = String(form.get("name") ?? "").trim();
		const company = String(form.get("company") ?? "").trim();
		const email = String(form.get("email") ?? "").trim().toLowerCase();
		const role = form.get("role") === "admin" ? "admin" : "customer";
		const active = form.get("active") === "1" ? 1 : 0;
		if (!name || !email) return Astro.redirect(`${here}?err=invalid`);
		if (isSelf && (role !== "admin" || !active)) return Astro.redirect(`${here}?err=self`);
		const clash = await DB.prepare("SELECT 1 FROM users WHERE email = ? AND id != ?").bind(email, user.id).first();
		if (clash) return Astro.redirect(`${here}?err=exists`);
		await DB.batch([
			DB.prepare(
				"UPDATE users SET name = ?, company = ?, email = ?, role = ?, active = ?, failed_logins = 0, locked_until = NULL WHERE id = ?",
			).bind(name, company, email, role, active, user.id),
			audit(DB, admin.id, "user_update", email),
		]);
		if (!active) await destroyUserSessions(DB, user.id);
		return Astro.redirect(`${here}?ok=saved`);
	}

	if (action === "password") {
		const password = String(form.get("password") ?? "");
		error = passwordProblem(password, t);
		if (!error) {
			await DB.batch([
				DB.prepare("UPDATE users SET password_hash = ?, failed_logins = 0, locked_until = NULL WHERE id = ?").bind(
					await hashPassword(password),
					user.id,
				),
				audit(DB, admin.id, "password_reset", user.email),
			]);
			if (!isSelf) await destroyUserSessions(DB, user.id);
			return Astro.redirect(`${here}?ok=password`);
		}
	}

	if (action === "access") {
		const changes = (await readAccessForm(DB, form)).filter((c) => c.userId === user.id);
		await saveAccess(DB, admin.id, changes);
		return Astro.redirect(`${here}?ok=access`);
	}

	if (action === "reset_2fa") {
		// For a customer who lost their phone; they can sign in with the password and set it up again.
		await DB.batch([...clearTotp(DB, user.id), audit(DB, admin.id, "2fa_reset", user.email)]);
		if (!isSelf) await destroyUserSessions(DB, user.id);
		return Astro.redirect(`${here}?ok=mfa_reset`);
	}

	if (action === "delete") {
		if (isSelf) return Astro.redirect(`${here}?err=self`);
		await DB.batch([
			DB.prepare("DELETE FROM users WHERE id = ?").bind(user.id),
			audit(DB, admin.id, "user_delete", user.email),
		]);
		return Astro.redirect("/portal/admin/users?ok=deleted");
	}
}

const [roots, perms] = await Promise.all([listRoots(DB), permissionMap(DB)]);
const level = (folderId: number) => perms.get(`${user.id}:${folderId}`) ?? "none";
const locked = user.locked_until !== null && user.locked_until > Math.floor(Date.now() / 1000);
const initials = user.name
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => w[0]!.toLocaleUpperCase(lang))
	.join("");
const credentialsTemplate = rawMessage(lang, "admin.credentials_text");
const portalUrl = `${Astro.url.origin}/portal`;
---

<Portal title={user.name} error={error}>
	<div class="page-head">
		<div>
			<nav class="breadcrumb">
				<a href="/portal/admin/users"><Icon name="users" size={14} /> {t("admin.tab_users")}</a>
				<Icon name="chevron" size={14} />
			</nav>
			<h1>{user.name}</h1>
		</div>
	</div>

	<AdminTabs />

	<div class="profile panel">
		<span class="avatar big">{initials}</span>
		<div class="profile-main">
			<strong>{user.name}</strong>
			<span class="muted">{user.email}{user.company && ` · ${user.company}`}</span>
			<div class="badges">
				{user.role === "admin" ? <span class="badge">{t("common.admin")}</span> : <span class="badge gray">{t("common.customer")}</span>}
				{user.active ? <span class="badge green">{t("admin.active")}</span> : <span class="badge red">{t("common.inactive")}</span>}
				{locked && <span class="badge red">{t("common.locked")}</span>}
				{user.totp_enabled ? (
					<span class="badge green"><Icon name="shield" size={12} /> {t("mfa.badge_on")}</span>
				) : (
					<span class="badge gray">{t("mfa.badge_off")}</span>
				)}
			</div>
		</div>
		<dl class="kv">
			<div>
				<dt>{t("admin.last_login")}</dt>
				<dd title={user.last_login ? formatDate(user.last_login, lang) : undefined}>
					{user.last_login ? formatRelative(user.last_login, lang, t) : t("admin.never")}
				</dd>
			</div>
			<div>
				<dt>{t("admin.member_since")}</dt>
				<dd>{formatDate(user.created_at, lang)}</dd>
			</div>
		</dl>
	</div>

	<div class="grid-2">
		<div class="panel">
			<h2>{t("admin.details")}</h2>
			<form method="post" class="stack">
				<input type="hidden" name="action" value="update" />
				<label>{t("common.name")} <input type="text" name="name" value={user.name} required /></label>
				<label>{t("common.company")} <input type="text" name="company" value={user.company} /></label>
				<label>{t("common.email")} <input type="email" name="email" value={user.email} required /></label>
				<label>
					{t("common.role")}
					<select name="role">
						<option value="customer" selected={user.role === "customer"}>{t("common.customer")}</option>
						<option value="admin" selected={user.role === "admin"}>{t("common.admin")}</option>
					</select>
				</label>
				<label class="check">
					<input type="checkbox" name="active" value="1" checked={user.active === 1} /> {t("admin.account_active")}
				</label>
				<div><button type="submit" class="btn">{t("common.save")}</button></div>
				{locked && <p class="hint">{t("admin.save_unlocks")}</p>}
			</form>
		</div>

		<div class="panel">
			<h2>{t("admin.reset_password")}</h2>
			<form method="post" class="stack" id="pw-form">
				<input type="hidden" name="action" value="password" />
				<label>
					{t("account.new")}
					<span class="input-row">
						<input type="text" name="password" id="pw" value={randomPassword()} required minlength="10" autocomplete="off" spellcheck="false" />
						<button type="button" class="btn secondary small" id="pw-gen"><Icon name="activity" size={14} /> {t("admin.generate")}</button>
					</span>
					<span class="hint">{t("admin.reset_hint")}</span>
				</label>
				<div class="dialog-actions spread">
					<button type="button" class="btn secondary" id="copy-creds" data-done={t("admin.copied")} data-email={user.email}>
						<Icon name="file" size={16} /> <span>{t("admin.copy_credentials")}</span>
					</button>
					<button type="submit" class="btn">{t("admin.reset_submit")}</button>
				</div>
			</form>
		</div>
	</div>

	<div class="panel">
		<div class="panel-head">
			<h2>{t("admin.permissions")}</h2>
			{user.role === "customer" && roots.length > 0 && <a class="btn small secondary" href="/portal/admin/access"><Icon name="shield" size={14} /> {t("admin.access_title")}</a>}
		</div>
		{
			user.role === "admin" ? (
				<p class="muted">{t("admin.admins_all")}</p>
			) : roots.length === 0 ? (
				<p class="muted">
					<a href="/portal/admin/folders#new">{t("admin.create_folder_first")}</a>
				</p>
			) : (
				<form method="post" data-access-form>
					<input type="hidden" name="action" value="access" />
					<p class="hint">{t("admin.folder_access_lead")}</p>
					<div class="access-list">
						{roots.map((r) => (
							<div class="access-item">
								<span class="file-type folder"><Icon name="folder" size={18} /></span>
								<a class="access-name" href={`/portal/admin/folders/${r.id}`}>{r.name}</a>
								<AccessSelect name={`access:${user.id}:${r.id}`} value={level(r.id)} label={r.name} />
							</div>
						))}
					</div>
					<p class="hint">{t("admin.upload_only_hint")}</p>
					<div class="save-bar" data-save-bar data-template={rawMessage(lang, "admin.access_changed")}>
						<span data-count></span>
						<button type="button" class="btn secondary small" data-reset>{t("admin.access_reset")}</button>
						<button type="submit" class="btn">{t("admin.save_permissions")}</button>
					</div>
				</form>
			)
		}
	</div>

	{
		!isSelf && (
			<div class="panel danger-zone">
				<h2>{t("admin.danger")}</h2>
				{user.totp_enabled === 1 && (
					<form method="post" data-confirm={t("mfa.reset_confirm")} class="danger-row">
						<input type="hidden" name="action" value="reset_2fa" />
						<p class="hint">{t("mfa.reset_hint")}</p>
						<button type="submit" class="btn secondary"><Icon name="shield" size={16} /> {t("mfa.reset")}</button>
					</form>
				)}
				<form method="post" data-confirm={t("admin.delete_user_confirm")} class="danger-row">
					<input type="hidden" name="action" value="delete" />
					<p class="hint">{t("admin.delete_user_hint")}</p>
					<button type="submit" class="btn danger"><Icon name="trash" size={16} /> {t("admin.delete_user")}</button>
				</form>
			</div>
		)
	}
</Portal>

<!-- The email is read from a data attribute: user input must not be inlined into a script. -->
<script define:vars={{ credentialsTemplate, portalUrl }}>
	const pw = document.getElementById("pw");
	document.getElementById("pw-gen").addEventListener("click", () => {
		const alphabet = "abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
		pw.value = Array.from(crypto.getRandomValues(new Uint8Array(14)), (b) => alphabet[b % alphabet.length]).join("");
	});
	const copy = document.getElementById("copy-creds");
	copy.addEventListener("click", async () => {
		const text = credentialsTemplate.replace("{url}", portalUrl).replace("{email}", copy.dataset.email).replace("{password}", pw.value);
		await navigator.clipboard.writeText(text);
		const label = copy.querySelector("span");
		const before = label.textContent;
		label.textContent = copy.dataset.done;
		setTimeout(() => (label.textContent = before), 1800);
	});
</script>
