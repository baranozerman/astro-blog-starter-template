---
import Portal from "../../../layouts/Portal.astro";
import Icon from "../../../components/portal/Icon.astro";
import AdminTabs from "../../../components/portal/AdminTabs.astro";
import { formatBytes, formatDate } from "../../../lib/portal";
import { isMessageKey } from "../../../lib/i18n";

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const { lang, t } = Astro.locals;

const [counts, activity] = await DB.batch<any>([
	DB.prepare(
		`SELECT (SELECT COUNT(*) FROM users WHERE role = 'customer') AS customers,
		        (SELECT COUNT(*) FROM folders WHERE parent_id IS NULL) AS roots,
		        (SELECT COUNT(*) FROM files) AS files,
		        (SELECT COALESCE(SUM(size), 0) FROM files) AS bytes`,
	),
	DB.prepare(
		`SELECT a.action, a.detail, a.created_at, u.id AS user_id, u.name
		 FROM audit_log a LEFT JOIN users u ON u.id = a.user_id
		 ORDER BY a.id DESC LIMIT 40`,
	),
]);
const c = counts.results[0];
const stats = [
	{ icon: "users" as const, value: c.customers, label: t("admin.stat_customers"), href: "/portal/admin/users" },
	{ icon: "folder" as const, value: c.roots, label: t("admin.stat_folders"), href: "/portal/admin/folders" },
	{ icon: "file" as const, value: c.files, label: t("admin.stat_files"), href: "/portal/admin/folders" },
	{ icon: "database" as const, value: formatBytes(c.bytes, lang), label: t("admin.stat_size"), href: "/portal/admin/folders" },
];
const actionLabel = (action: string) => {
	const key = `action.${action}`;
	return isMessageKey(key) ? t(key) : action;
};
const actionIcon: Record<string, "upload" | "download" | "trash" | "user" | "folder" | "shield" | "logout" | "pencil" | "move"> = {
	upload: "upload",
	download: "download",
	delete: "trash",
	folder_delete: "trash",
	user_delete: "trash",
	login: "logout",
	user_create: "user",
	user_update: "user",
	folder_create: "folder",
	folder_update: "folder",
	permissions: "shield",
	rename: "pencil",
	move: "move",
};
---

<Portal title={t("admin.title")}>
	<div class="page-head">
		<div>
			<h1>{t("admin.title")}</h1>
			<p class="muted">{t("admin.lead")}</p>
		</div>
		<div class="head-actions">
			<a class="btn glass" href="/portal/admin/folders#new"><Icon name="folderPlus" /> {t("admin.new_root")}</a>
			<a class="btn" href="/portal/admin/users#new"><Icon name="plus" /> {t("admin.new_user")}</a>
		</div>
	</div>

	<AdminTabs />

	<div class="stats">
		{
			stats.map((s) => (
				<a class="stat" href={s.href}>
					<span class="stat-icon">
						<Icon name={s.icon} size={20} />
					</span>
					<div>
						<strong>{s.value}</strong>
						<span>{s.label}</span>
					</div>
				</a>
			))
		}
	</div>

	<div class="panel">
		<div class="panel-head">
			<h2>{t("admin.activity")}</h2>
		</div>
		{
			activity.results.length === 0 ? (
				<p class="empty">{t("admin.no_activity")}</p>
			) : (
				<ul class="timeline">
					{activity.results.map((a: any) => (
						<li>
							<span class="timeline-icon">
								<Icon name={actionIcon[a.action] ?? "activity"} size={15} />
							</span>
							<div>
								<p>
									<strong>
										{a.user_id ? <a href={`/portal/admin/users/${a.user_id}`}>{a.name}</a> : t("admin.deleted_user")}
									</strong>{" "}
									· {actionLabel(a.action)}
								</p>
								{a.detail && <p class="muted small">{a.detail}</p>}
							</div>
							<time class="muted small">{formatDate(a.created_at, lang)}</time>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Portal>
