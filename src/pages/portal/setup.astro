---
import Portal from "../../layouts/Portal.astro";
import { createSession, hashPassword, passwordProblem } from "../../lib/auth";
import { audit } from "../../lib/portal";

export const prerender = false;

// One-time page that creates the first administrator. It is disabled as soon
// as any user exists, and requires the SETUP_TOKEN secret so nobody else can
// claim a freshly deployed portal.
const { DB, SETUP_TOKEN } = Astro.locals.runtime.env;
const { t } = Astro.locals;
const userCount = await DB.prepare("SELECT COUNT(*) AS n FROM users").first<number>("n");
if (userCount !== 0) return Astro.redirect("/portal/login");

let error = "";
const values = { email: "", name: "", company: "Prodinox" };
if (Astro.request.method === "POST" && SETUP_TOKEN) {
	const form = await Astro.request.formData();
	values.email = String(form.get("email") ?? "").trim().toLowerCase();
	values.name = String(form.get("name") ?? "").trim();
	values.company = String(form.get("company") ?? "").trim();
	const password = String(form.get("password") ?? "");

	if (String(form.get("token") ?? "") !== SETUP_TOKEN) error = t("err.bad_setup_token");
	else if (!values.email || !values.name) error = t("err.name_email_required");
	else error = passwordProblem(password, t);

	if (!error) {
		const { meta } = await DB.prepare(
			`INSERT INTO users (email, name, company, password_hash, role)
			 SELECT ?, ?, ?, ?, 'admin' WHERE NOT EXISTS (SELECT 1 FROM users)`,
		)
			.bind(values.email, values.name, values.company, await hashPassword(password))
			.run();
		if (meta.changes !== 1) return Astro.redirect("/portal/login");
		const userId = meta.last_row_id;
		await audit(DB, userId, "setup", values.email).run();
		await createSession(DB, Astro.cookies, Astro.url, userId);
		return Astro.redirect("/portal/admin?ok=created");
	}
}
---

<Portal title={t("setup.title")} bare error={error}>
	<div>
		<h2>{t("setup.heading")}</h2>
		<p class="lead">{t("setup.lead")}</p>
		{
			SETUP_TOKEN ? (
				<form method="post" class="stack">
					<label>
						{t("setup.token")}
						<input type="password" name="token" required />
						<span class="hint">{t("setup.token_hint")}</span>
					</label>
					<label>
						{t("common.name")}
						<input type="text" name="name" value={values.name} required />
					</label>
					<label>
						{t("common.company")}
						<input type="text" name="company" value={values.company} />
					</label>
					<label>
						{t("common.email")}
						<input type="email" name="email" value={values.email} required autocomplete="username" />
					</label>
					<label>
						{t("common.password")}
						<input type="password" name="password" required minlength="10" autocomplete="new-password" />
					</label>
					<button type="submit" class="btn block">{t("setup.submit")}</button>
				</form>
			) : (
				<p>
					{t("setup.missing")}
					<br />
					<code>npx wrangler secret put SETUP_TOKEN</code>
					<br />
					{t("setup.missing_local")}
				</p>
			)
		}
	</div>
</Portal>
