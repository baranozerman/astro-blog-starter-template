---
import Portal from "../../../layouts/Portal.astro";
import Icon from "../../../components/portal/Icon.astro";
import {
	INLINE_TYPES,
	MAX_UPLOAD_BYTES,
	audit,
	cleanFileName,
	fileKind,
	formatBytes,
	formatDate,
	formatRelative,
	getFolderAccess,
	parseId,
	type FileRow,
} from "../../../lib/portal";
import { StorageError, deleteStored, storeUpload } from "../../../lib/storage";

export const prerender = false;

const env = Astro.locals.runtime.env;
const { DB } = env;
const user = Astro.locals.user!;
const folderId = parseId(Astro.params.id);
const access = folderId ? await getFolderAccess(DB, user, folderId) : null;
if (!access) return Astro.redirect("/portal?err=forbidden");
const { folder, canRead, canUpload } = access;
const isAdmin = user.role === "admin";
const here = `/portal/folders/${folder.id}`;

if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const action = form.get("action");

	if (action === "upload") {
		if (!canUpload) return Astro.redirect(`${here}?err=forbidden`);
		const files = form.getAll("files").filter((f): f is File => f instanceof File && f.size > 0);
		if (files.length === 0) return Astro.redirect(`${here}?err=nofile`);
		const total = files.reduce((sum, f) => sum + f.size, 0);
		if (total > MAX_UPLOAD_BYTES) return Astro.redirect(`${here}?err=toolarge`);

		for (const file of files) {
			const name = cleanFileName(file.name);
			const contentType = file.type || "application/octet-stream";
			let key: string;
			try {
				key = await storeUpload(env, folder.id, name, file, contentType);
			} catch (e) {
				if (e instanceof StorageError) {
					console.error(e.message);
					return Astro.redirect(`${here}?err=storage`);
				}
				throw e;
			}
			await DB.batch([
				DB.prepare(
					`INSERT INTO files (folder_id, r2_key, name, size, content_type, uploaded_by)
					 VALUES (?, ?, ?, ?, ?, ?)`,
				).bind(folder.id, key, name, file.size, contentType, user.id),
				audit(DB, user.id, "upload", `${folder.name} / ${name}`),
			]);
		}
		return Astro.redirect(`${here}?ok=uploaded`);
	}

	if (action === "delete") {
		const fileId = parseId(String(form.get("file_id")));
		const file = fileId
			? await DB.prepare("SELECT * FROM files WHERE id = ? AND folder_id = ?")
					.bind(fileId, folder.id)
					.first<FileRow>()
			: null;
		// Admins can delete anything; customers only their own uploads.
		if (!file || !(isAdmin || (canUpload && file.uploaded_by === user.id))) {
			return Astro.redirect(`${here}?err=forbidden`);
		}
		try {
			await deleteStored(env, [file.r2_key]);
		} catch (e) {
			if (e instanceof StorageError) {
				console.error(e.message);
				return Astro.redirect(`${here}?err=storage`);
			}
			throw e;
		}
		await DB.batch([
			DB.prepare("DELETE FROM files WHERE id = ?").bind(file.id),
			audit(DB, user.id, "delete", `${folder.name} / ${file.name}`),
		]);
		return Astro.redirect(`${here}?ok=deleted`);
	}
}

// Upload-only users see just the files they uploaded themselves.
const { results: files } = await DB.prepare(
	`SELECT f.*, u.name AS uploader
	 FROM files f LEFT JOIN users u ON u.id = f.uploaded_by
	 WHERE f.folder_id = ? ${canRead ? "" : "AND f.uploaded_by = ?"}
	 ORDER BY f.created_at DESC, f.id DESC`,
)
	.bind(...(canRead ? [folder.id] : [folder.id, user.id]))
	.all<FileRow & { uploader: string | null }>();
const maxMb = Math.round(MAX_UPLOAD_BYTES / 1024 / 1024);
---

<Portal title={folder.name}>
	<div class="page-head">
		<div>
			<div class="breadcrumb">
				<a href="/portal">Dosyalar</a>
				<Icon name="chevron" size={14} />
			</div>
			<h1>{folder.name}</h1>
			{folder.description && <p class="muted">{folder.description}</p>}
		</div>
		{
			isAdmin && (
				<a class="btn secondary" href={`/portal/admin/folders/${folder.id}`}>
					<Icon name="settings" /> Klasör ayarları
				</a>
			)
		}
	</div>

	{
		canUpload && (
			<div class="panel">
				<form method="post" enctype="multipart/form-data" id="upload-form">
					<input type="hidden" name="action" value="upload" />
					<label class="dropzone" id="dropzone">
						<Icon name="upload" size={30} />
						<strong>Dosyaları sürükleyip bırakın veya seçmek için dokunun</strong>
						<span class="hint">Tek seferde toplam en fazla {maxMb} MB</span>
						<input type="file" name="files" multiple required id="file-input" />
					</label>
					<ul class="selected" id="selected" hidden />
					<div class="upload-actions" id="upload-actions" hidden>
						<button type="submit" class="btn" id="upload-btn">
							<Icon name="upload" /> Yükle
						</button>
						<div class="progress" id="progress" hidden>
							<div />
						</div>
						<span class="hint" id="upload-status" />
					</div>
				</form>
			</div>
		)
	}

	<div class="panel">
		<div class="panel-head">
			<h2>
				{canRead ? "Dosyalar" : "Yüklediğiniz dosyalar"} <span class="badge gray">{files.length}</span>
			</h2>
			{
				files.length > 5 && (
					<div class="search">
						<Icon name="search" size={16} />
						<input type="search" id="file-search" placeholder="Dosya ara…" aria-label="Dosya ara" />
					</div>
				)
			}
		</div>
		{
			files.length === 0 ? (
				<div class="empty">
					<Icon name="file" size={36} />
					<span>Bu klasörde henüz dosya yok.</span>
				</div>
			) : (
				<div class="files" id="files">
					<div class="file-row head">
						<span>Ad</span>
						<span>Boyut</span>
						<span>Yükleyen</span>
						<span>Tarih</span>
						<span />
					</div>
					{files.map((f) => {
						const kind = fileKind(f.name);
						const canDelete = isAdmin || (canUpload && f.uploaded_by === user.id);
						return (
							<div class="file-row" data-name={f.name.toLocaleLowerCase("tr-TR")}>
								<div class="file-name">
									<span class:list={["file-type", kind.group]}>{kind.label}</span>
									<div>
										<a href={`/portal/files/${f.id}`} title={f.name}>
											{f.name}
										</a>
										<span class="file-sub">
											{formatBytes(f.size)} · {formatRelative(f.created_at)}
											{f.uploader && ` · ${f.uploader}`}
										</span>
									</div>
								</div>
								<span class="file-meta">{formatBytes(f.size)}</span>
								<span class="file-meta">{f.uploader ?? "—"}</span>
								<span class="file-meta" title={formatDate(f.created_at)}>
									{formatRelative(f.created_at)}
								</span>
								<div class="file-actions">
									{INLINE_TYPES.has(f.content_type) && (
										<a
											class="btn small secondary icon-only"
											href={`/portal/files/${f.id}?inline`}
											target="_blank"
											rel="noopener"
											title="Görüntüle"
											aria-label={`${f.name} görüntüle`}
										>
											<Icon name="eye" size={16} />
										</a>
									)}
									<a
										class="btn small secondary icon-only"
										href={`/portal/files/${f.id}`}
										title="İndir"
										aria-label={`${f.name} indir`}
									>
										<Icon name="download" size={16} />
									</a>
									{canDelete && (
										<form method="post" data-confirm="Bu dosya silinsin mi?">
											<input type="hidden" name="action" value="delete" />
											<input type="hidden" name="file_id" value={f.id} />
											<button
												type="submit"
												class="btn small danger icon-only"
												title="Sil"
												aria-label={`${f.name} sil`}
											>
												<Icon name="trash" size={16} />
											</button>
										</form>
									)}
								</div>
							</div>
						);
					})}
				</div>
			)
		}
	</div>
</Portal>

<script define:vars={{ maxBytes: MAX_UPLOAD_BYTES }}>
	const form = document.getElementById("upload-form");
	const input = document.getElementById("file-input");
	const dropzone = document.getElementById("dropzone");
	const list = document.getElementById("selected");
	const actions = document.getElementById("upload-actions");
	const button = document.getElementById("upload-btn");
	const progress = document.getElementById("progress");
	const status = document.getElementById("upload-status");

	const fmt = (n) =>
		n < 1024 * 1024
			? `${Math.max(1, Math.round(n / 1024))} KB`
			: `${(n / 1024 / 1024).toLocaleString("tr-TR", { maximumFractionDigits: 1 })} MB`;

	function showSelection() {
		const files = [...input.files];
		const total = files.reduce((sum, f) => sum + f.size, 0);
		list.replaceChildren(
			...files.map((f) => {
				const li = document.createElement("li");
				const name = document.createElement("span");
				const size = document.createElement("span");
				name.textContent = f.name;
				size.textContent = fmt(f.size);
				size.className = "hint";
				li.append(name, size);
				return li;
			}),
		);
		list.hidden = actions.hidden = files.length === 0;
		const tooBig = total > maxBytes;
		button.disabled = tooBig;
		status.textContent = tooBig
			? `Toplam ${fmt(total)}: sınır ${fmt(maxBytes)}. Lütfen daha az dosya seçin.`
			: `${files.length} dosya, toplam ${fmt(total)}`;
	}

	if (form) {
		input.addEventListener("change", showSelection);
		for (const type of ["dragenter", "dragover"]) {
			dropzone.addEventListener(type, (e) => {
				e.preventDefault();
				dropzone.classList.add("drag");
			});
		}
		for (const type of ["dragleave", "drop"]) {
			dropzone.addEventListener(type, () => dropzone.classList.remove("drag"));
		}
		dropzone.addEventListener("drop", (e) => {
			e.preventDefault();
			if (e.dataTransfer?.files.length) {
				input.files = e.dataTransfer.files;
				showSelection();
			}
		});

		// Upload with a progress bar; the server's redirect tells us the outcome.
		form.addEventListener("submit", (e) => {
			if (!input.files.length) return;
			e.preventDefault();
			const xhr = new XMLHttpRequest();
			xhr.open("POST", location.pathname);
			xhr.upload.addEventListener("progress", (ev) => {
				if (!ev.lengthComputable) return;
				const pct = Math.round((ev.loaded / ev.total) * 100);
				progress.firstElementChild.style.width = `${pct}%`;
				status.textContent = pct < 100 ? `Yükleniyor… %${pct}` : "İşleniyor…";
			});
			xhr.addEventListener("load", () => location.assign(xhr.responseURL || location.pathname));
			xhr.addEventListener("error", () => {
				status.textContent = "Bağlantı hatası. Lütfen tekrar deneyin.";
				button.disabled = false;
				progress.hidden = true;
			});
			button.disabled = true;
			progress.hidden = false;
			xhr.send(new FormData(form));
		});
	}

	const search = document.getElementById("file-search");
	search?.addEventListener("input", () => {
		const q = search.value.trim().toLocaleLowerCase("tr-TR");
		for (const row of document.querySelectorAll("#files .file-row[data-name]")) {
			row.hidden = q !== "" && !row.dataset.name.includes(q);
		}
	});

	for (const f of document.querySelectorAll("form[data-confirm]")) {
		f.addEventListener("submit", (e) => {
			if (!confirm(f.dataset.confirm)) e.preventDefault();
		});
	}
</script>
