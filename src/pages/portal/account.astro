---
import Portal from "../../layouts/Portal.astro";
import Icon from "../../components/portal/Icon.astro";
import {
	SESSION_COOKIE,
	destroyUserSessions,
	hasTotp,
	hashPassword,
	passwordProblem,
	verifyPassword,
} from "../../lib/auth";
import LangSwitch from "../../components/portal/LangSwitch.astro";
import { audit } from "../../lib/portal";

export const prerender = false;

const { DB } = Astro.locals.runtime.env;
const user = Astro.locals.user!;
const { t } = Astro.locals;
const mfaOn = await hasTotp(DB, user.id);

let error = "";
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	const current = String(form.get("current") ?? "");
	const password = String(form.get("password") ?? "");
	const confirm = String(form.get("confirm") ?? "");

	const stored = await DB.prepare("SELECT password_hash FROM users WHERE id = ?")
		.bind(user.id)
		.first<string>("password_hash");
	if (!stored || !(await verifyPassword(current, stored))) error = t("err.bad_current_password");
	else if (password !== confirm) error = t("err.password_mismatch");
	else error = passwordProblem(password, t);

	if (!error) {
		await DB.batch([
			DB.prepare("UPDATE users SET password_hash = ? WHERE id = ?").bind(
				await hashPassword(password),
				user.id,
			),
			audit(DB, user.id, "password_change"),
		]);
		await destroyUserSessions(DB, user.id, Astro.cookies.get(SESSION_COOKIE)?.value);
		return Astro.redirect("/portal/account?ok=password");
	}
}
---

<Portal title={t("account.title")} error={error}>
	<div class="page-head">
		<div>
			<h1>{t("account.title")}</h1>
			<p class="muted">{user.name} · {user.email}{user.company && ` · ${user.company}`}</p>
		</div>
	</div>
	<div class="grid-2">
		<div class="panel">
			<h2>{t("account.change_password")}</h2>
			<form method="post" class="stack">
				<label>
					{t("account.current")}
					<input type="password" name="current" required autocomplete="current-password" />
				</label>
				<label>
					{t("account.new")}
					<input type="password" name="password" required minlength="10" autocomplete="new-password" />
					<span class="hint">{t("account.new_hint")}</span>
				</label>
				<label>
					{t("account.repeat")}
					<input type="password" name="confirm" required minlength="10" autocomplete="new-password" />
				</label>
				<div><button type="submit" class="btn">{t("account.submit")}</button></div>
			</form>
		</div>
		<div class="panel">
			<h2>{t("mfa.title")}</h2>
			<div class:list={["mfa-status", { on: mfaOn }]}>
				<span class="mfa-status-icon"><Icon name="shield" size={22} /></span>
				<div>
					<strong>{mfaOn ? t("mfa.on") : t("mfa.off")}</strong>
					<span class="muted">{mfaOn ? t("mfa.on_body") : t("mfa.off_body")}</span>
				</div>
			</div>
			<a class:list={["btn", { secondary: mfaOn }]} href="/portal/account/2fa">
				<Icon name="shield" size={16} /> {mfaOn ? t("mfa.manage") : t("mfa.enable")}
			</a>
			<h2 class="mt">{t("account.language")}</h2>
			<LangSwitch />
			<h2 class="mt">{t("privacy.title")}</h2>
			<p class="muted">{t("privacy.summary")}</p>
			<a class="btn secondary small" href="/portal/privacy"><Icon name="shield" size={14} /> {t("privacy.link")}</a>
		</div>
	</div>
</Portal>
