---
// Official Prodinox logo (vectorised from the company presentation).
interface Props {
	/** "light" on dark/photo backgrounds, "dark" on white. */
	tone?: "light" | "dark";
	/** Mark beside the wordmark, mark above it (as in the presentation), or the mark alone. */
	variant?: "horizontal" | "stacked" | "mark";
	height?: number;
}

const { tone = "light", variant = "horizontal", height = 34 } = Astro.props;
const file = { horizontal: "logo-h", stacked: "logo", mark: "mark" }[variant];
const src = `/brand/${file}-${tone === "light" ? "white" : "navy"}.svg`;
---

<img class="logo" src={src} alt="Prodinox" height={height} style={`height:${height}px`} />
