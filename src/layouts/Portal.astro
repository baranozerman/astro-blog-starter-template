---
import "../styles/portal.css";
import Icon from "../components/portal/Icon.astro";
import Logo from "../components/portal/Logo.astro";
import { MESSAGES } from "../lib/portal";
import { BACKDROPS, todaysBackdrop } from "../lib/backdrops";

interface Props {
	title: string;
	/** Inline error rendered above the page content (e.g. form validation). */
	error?: string;
	/** Login/setup layout: a single floating card over the backdrop, no navigation. */
	bare?: boolean;
}

const { title, error, bare = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const ok = MESSAGES[Astro.url.searchParams.get("ok") ?? ""];
const err = error || MESSAGES[Astro.url.searchParams.get("err") ?? ""];
// Login shows a different image on each visit; inside the app it stays put for the day.
const backdrop = bare ? BACKDROPS[Math.floor(Math.random() * BACKDROPS.length)] : todaysBackdrop();

const nav = [
	{ href: "/portal", label: "Dosyalar", icon: "folder" as const, active: path === "/portal" || path.startsWith("/portal/folders") },
	...(user?.role === "admin"
		? [{ href: "/portal/admin", label: "Yönetim", icon: "settings" as const, active: path.startsWith("/portal/admin") }]
		: []),
	{ href: "/portal/account", label: "Hesabım", icon: "user" as const, active: path.startsWith("/portal/account") },
];
const initials = (user?.name ?? "")
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => w[0]!.toLocaleUpperCase("tr-TR"))
	.join("");
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0b1424" />
		<link rel="icon" type="image/svg+xml" href="/portal-icon.svg" />
		<link rel="apple-touch-icon" href="/portal-icon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="preload" as="image" href={`/backgrounds/${backdrop.file}-1200.jpg`} media="(max-width: 860px)" />
		<link rel="preload" as="image" href={`/backgrounds/${backdrop.file}.jpg`} media="(min-width: 861px)" />
		<title>{title} · Prodinox</title>
	</head>
	<body class={bare ? "bare" : "app"}>
		<div class="backdrop" aria-hidden="true">
			<picture>
				<source media="(max-width: 860px)" srcset={`/backgrounds/${backdrop.file}-1200.jpg`} />
				<img src={`/backgrounds/${backdrop.file}.jpg`} alt="" style={`object-position:${backdrop.focus}`} />
			</picture>
		</div>

		{
			bare ? (
				<div class="auth">
					<a class="auth-logo" href="/portal">
						<Logo tone="light" height={46} />
					</a>
					<main class="auth-card">
						{ok && <p class="flash ok"><Icon name="check" />{ok}</p>}
						{err && <p class="flash err"><Icon name="alert" />{err}</p>}
						<slot />
					</main>
					<p class="slogan">
						<span>Meet</span> beyond <br /><span>the</span> visible.
					</p>
				</div>
			) : (
				<>
					<header class="topbar">
						<a class="topbar-logo" href="/portal">
							<Logo tone="light" height={34} />
							<span class="topbar-tag">Müşteri Portalı</span>
						</a>
						<nav class="pills">
							{nav.map((item) => (
								<a href={item.href} class:list={{ active: item.active }}>
									<Icon name={item.icon} size={16} />
									{item.label}
								</a>
							))}
						</nav>
						{user && (
							<div class="topbar-user">
								<span class="avatar" title={`${user.name} · ${user.company || user.email}`}>
									{initials}
								</span>
								<form method="post" action="/portal/logout">
									<button type="submit" class="icon-btn" title="Çıkış yap" aria-label="Çıkış yap">
										<Icon name="logout" />
									</button>
								</form>
							</div>
						)}
					</header>

					<main class="content">
						{ok && <p class="flash ok" data-autohide><Icon name="check" />{ok}</p>}
						{err && <p class="flash err"><Icon name="alert" />{err}</p>}
						<slot />
					</main>

					<nav class="tabbar">
						{nav.map((item) => (
							<a href={item.href} class:list={{ active: item.active }}>
								<Icon name={item.icon} size={22} />
								<span>{item.label}</span>
							</a>
						))}
					</nav>
				</>
			)
		}
		<p class="credit">{backdrop.caption}</p>

		<script>
			// Fade out success messages after a few seconds.
			for (const el of document.querySelectorAll<HTMLElement>("[data-autohide]")) {
				setTimeout(() => el.classList.add("hide"), 4000);
			}
			// Drop ?ok= / ?err= from the address bar so a refresh doesn't repeat the message.
			const url = new URL(location.href);
			if (url.searchParams.has("ok") || url.searchParams.has("err")) {
				url.searchParams.delete("ok");
				url.searchParams.delete("err");
				history.replaceState(null, "", url);
			}
		</script>
	</body>
</html>
