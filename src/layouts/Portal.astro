---
import "../styles/portal.css";
import Icon from "../components/portal/Icon.astro";
import Logo from "../components/portal/Logo.astro";
import LangSwitch from "../components/portal/LangSwitch.astro";
import { MAX_UPLOAD_BYTES } from "../lib/portal";
import { BACKDROPS, todaysBackdrop } from "../lib/backdrops";
import { isMessageKey } from "../lib/i18n";

interface Props {
	title: string;
	/** Inline error rendered above the page content (e.g. form validation). */
	error?: string;
	/** Login/setup layout: a single floating card over the backdrop, no navigation. */
	bare?: boolean;
}

const { title, error, bare = false } = Astro.props;
const { user, lang, t } = Astro.locals;
const path = Astro.url.pathname;
const flash = (code: string | null) => {
	const key = `flash.${code}`;
	return code && isMessageKey(key) ? t(key, { mb: Math.round(MAX_UPLOAD_BYTES / 1024 / 1024) }) : "";
};
const ok = flash(Astro.url.searchParams.get("ok"));
const err = error || flash(Astro.url.searchParams.get("err"));
const WEBSITE = "https://prodinox.com.tr";
// Login shows a different image on each visit; inside the app it stays put for the day.
const backdrop = bare ? BACKDROPS[Math.floor(Math.random() * BACKDROPS.length)] : todaysBackdrop();

const nav = [
	{ href: "/portal", label: t("nav.files"), icon: "folder" as const, active: path === "/portal" || path.startsWith("/portal/folders") },
	...(user?.role === "admin"
		? [{ href: "/portal/admin", label: t("nav.admin"), icon: "settings" as const, active: path.startsWith("/portal/admin") }]
		: []),
	{ href: "/portal/account", label: t("nav.account"), icon: "user" as const, active: path.startsWith("/portal/account") },
];
const initials = (user?.name ?? "")
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => w[0]!.toLocaleUpperCase(lang))
	.join("");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0b1424" />
		<link rel="icon" type="image/svg+xml" href="/portal-icon.svg" />
		<link rel="apple-touch-icon" href="/portal-icon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="preload" as="image" href={`/backgrounds/${backdrop.file}-1200.jpg`} media="(max-width: 860px)" />
		<link rel="preload" as="image" href={`/backgrounds/${backdrop.file}.jpg`} media="(min-width: 861px)" />
		<title>{title} · Prodinox</title>
	</head>
	<body class={bare ? "bare" : "app"}>
		<div class="backdrop" aria-hidden="true">
			<picture>
				<source media="(max-width: 860px)" srcset={`/backgrounds/${backdrop.file}-1200.jpg`} />
				<img src={`/backgrounds/${backdrop.file}.jpg`} alt="" style={`object-position:${backdrop.focus}`} />
			</picture>
		</div>

		{
			bare ? (
				<div class="auth">
					<div class="auth-top">
						<a class="auth-logo" href="/portal">
							<Logo tone="light" height={46} />
						</a>
						<div class="auth-links">
							<a class="site-link" href={WEBSITE} target="_blank" rel="noopener">
								<Icon name="globe" size={16} />
								<span>{t("app.website")}</span>
								<Icon name="external" size={14} />
							</a>
							<LangSwitch />
						</div>
					</div>
					<main class="auth-card">
						{ok && <p class="flash ok"><Icon name="check" />{ok}</p>}
						{err && <p class="flash err"><Icon name="alert" />{err}</p>}
						<slot />
					</main>
					<p class="slogan">
						<span>{t("app.slogan_a")}</span> {t("app.slogan_b")} <br /><span>{t("app.slogan_c")}</span> {t("app.slogan_d")}
					</p>
				</div>
			) : (
				<>
					<header class="topbar">
						<a class="topbar-logo" href="/portal">
							<Logo tone="light" height={34} />
							<span class="topbar-tag">{t("app.tagline")}</span>
						</a>
						<nav class="pills">
							{nav.map((item) => (
								<a href={item.href} class:list={{ active: item.active }}>
									<Icon name={item.icon} size={16} />
									{item.label}
								</a>
							))}
						</nav>
						<a class="site-link" href={WEBSITE} target="_blank" rel="noopener" title={t("app.website")}>
							<Icon name="globe" size={16} />
							<span>{t("app.website")}</span>
							<Icon name="external" size={14} />
						</a>
						<LangSwitch />
						{user && (
							<div class="topbar-user">
								<span class="avatar" title={`${user.name} · ${user.company || user.email}`}>
									{initials}
								</span>
								<form method="post" action="/portal/logout">
									<button type="submit" class="icon-btn" title={t("nav.logout")} aria-label={t("nav.logout")}>
										<Icon name="logout" />
									</button>
								</form>
							</div>
						)}
					</header>

					<main class="content">
						{ok && <p class="flash ok" data-autohide><Icon name="check" />{ok}</p>}
						{err && <p class="flash err"><Icon name="alert" />{err}</p>}
						<slot />
					</main>

					<nav class="tabbar">
						{nav.map((item) => (
							<a href={item.href} class:list={{ active: item.active }}>
								<Icon name={item.icon} size={22} />
								<span>{item.label}</span>
							</a>
						))}
					</nav>
				</>
			)
		}
		<p class="credit">{t(backdrop.caption)}</p>

		<script>
			// Forms that need a confirmation carry the (translated) question in data-confirm.
			for (const form of document.querySelectorAll<HTMLFormElement>("form[data-confirm]")) {
				form.addEventListener("submit", (e) => {
					if (!confirm(form.dataset.confirm)) e.preventDefault();
				});
			}
			// Fade out success messages after a few seconds.
			for (const el of document.querySelectorAll<HTMLElement>("[data-autohide]")) {
				setTimeout(() => el.classList.add("hide"), 4000);
			}
			// Drop ?ok= / ?err= from the address bar so a refresh doesn't repeat the message.
			const url = new URL(location.href);
			if (url.searchParams.has("ok") || url.searchParams.has("err")) {
				url.searchParams.delete("ok");
				url.searchParams.delete("err");
				history.replaceState(null, "", url);
			}
		</script>
	</body>
</html>
